# Pairing token for the TV's YouTube app: run scripts/pair.sh once and copy the screen_id.
# SECRET — it is a remote control for that YouTube app. Never commit it.
ISBTV_SCREEN_ID=

# Label shown in the logs and in the TV's "connected devices" list
ISBTV_DEVICE_NAME=Chromecast
ISBTV_DEVICE_OFFSET=0                  # ms to shift every skip by, if the TV seeks late

# Segment categories to skip, comma-separated. Available: sponsor, selfpromo,
# exclusive_access, interaction, intro, outro, preview, filler, music_offtopic, hook
ISBTV_SKIP_CATEGORIES=sponsor
ISBTV_MIN_SKIP_LENGTH=1                # ignore segments shorter than this (seconds)

# YouTube's own ads (not SponsorBlock segments)
ISBTV_MUTE_ADS=true
ISBTV_SKIP_ADS=true

ISBTV_AUTO_PLAY=true                   # let the TV keep autoplaying the next video
ISBTV_SKIP_COUNT_TRACKING=true         # anonymous "segment skipped" ping to sponsor.ajay.app

# Channel IDs never to skip on, comma-separated (e.g. UCxxxx,UCyyyy)
ISBTV_CHANNEL_WHITELIST=

# YouTube Data API key — only needed to resolve videos the Lounge API doesn't identify
ISBTV_APIKEY=

TZ=Europe/Brussels
